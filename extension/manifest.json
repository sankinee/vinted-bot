{
  "manifest_version": 3,
  "name": "Flipdar Bridge",
  "version": "3.3.0",
  "description": "Pont Flipdar ⇄ Vinted : recherche, suivi des ventes et achat automatique (avec limites).",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*.vinted.fr/*",
    "https://*.vinted.be/*",
    "https://*.vinted.es/*",
    "https://*.vinted.it/*",
    "https://*.vinted.de/*",
    "https://*.vinted.nl/*",
    "https://*.vinted.pl/*",
    "https://*.vinted.pt/*",
    "https://*.vinted.lu/*",
    "https://*.vinted.at/*",
    "https://*.vinted.co.uk/*",
    "https://*.vinted.cz/*",
    "https://*.vinted.lt/*",
    "https://*.vinted.sk/*",
    "https://*.vinted.se/*",
    "https://*.vinted.fi/*",
    "https://*.vinted.dk/*",
    "https://*.vinted.hu/*",
    "https://*.vinted.ro/*",
    "https://*.vinted.hr/*",
    "https://*.vinted.gr/*",
    "https://*.vinted.ie/*",
    "https://*.vinted.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.github.io/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.vinted.fr/*",
        "https://*.vinted.be/*",
        "https://*.vinted.es/*",
        "https://*.vinted.it/*",
        "https://*.vinted.de/*",
        "https://*.vinted.nl/*",
        "https://*.vinted.pl/*",
        "https://*.vinted.pt/*",
        "https://*.vinted.lu/*",
        "https://*.vinted.at/*",
        "https://*.vinted.co.uk/*",
        "https://*.vinted.cz/*",
        "https://*.vinted.lt/*",
        "https://*.vinted.sk/*",
        "https://*.vinted.se/*",
        "https://*.vinted.fi/*",
        "https://*.vinted.dk/*",
        "https://*.vinted.hu/*",
        "https://*.vinted.ro/*",
        "https://*.vinted.hr/*",
        "https://*.vinted.gr/*",
        "https://*.vinted.ie/*",
        "https://*.vinted.com/*"
      ],
      "js": [
        "checkout.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.vinted.fr/*",
        "https://*.vinted.be/*",
        "https://*.vinted.es/*",
        "https://*.vinted.it/*",
        "https://*.vinted.de/*",
        "https://*.vinted.nl/*",
        "https://*.vinted.pl/*",
        "https://*.vinted.pt/*",
        "https://*.vinted.lu/*",
        "https://*.vinted.at/*",
        "https://*.vinted.co.uk/*",
        "https://*.vinted.cz/*",
        "https://*.vinted.lt/*",
        "https://*.vinted.sk/*",
        "https://*.vinted.se/*",
        "https://*.vinted.fi/*",
        "https://*.vinted.dk/*",
        "https://*.vinted.hu/*",
        "https://*.vinted.ro/*",
        "https://*.vinted.hr/*",
        "https://*.vinted.gr/*",
        "https://*.vinted.ie/*",
        "https://*.vinted.com/*"
      ],
      "js": [
        "relay.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Flipdar Bridge"
  }
}